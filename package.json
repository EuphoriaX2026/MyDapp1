{
  "name": "e-one-front",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "E.ONE - Decentralized organization.",
  "scripts": {
    "dev": "vite --host",
    "dev:restart": "powershell -NoProfile -Command \"$p = (Get-NetTCPConnection -LocalPort 5173 -State Listen -ErrorAction SilentlyContinue).OwningProcess | Select-Object -Unique; if ($p) { $p | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue } }; Start-Sleep -Seconds 1\" && vite --host",
    "dev:https": "vite --host --mode https",
    "dev:mobile": "concurrently -n vite,ngrok -c blue,magenta \"vite --host\" \"ngrok http --url=vocally-manifesto-hardwired.ngrok-free.dev 5173\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@iconify-react/basil": "^1.0.2",
    "@iconify-react/ic": "^1.0.2",
    "@iconify-react/material-symbols-light": "^1.0.19",
    "@iconify-react/tdesign": "^1.0.4",
    "@iconify-react/token-branded": "^1.0.2",
    "@iconify/react": "^6.0.2",
    "@ionic/react": "^8.6.1",
    "@rainbow-me/rainbowkit": "^2.2.7",
    "@splidejs/splide": "^4.1.4",
    "@tanstack/react-query": "^5.90.21",
    "@types/bootstrap": "^5.2.10",
    "apexcharts": "^4.7.0",
    "bootstrap": "^5.3.6",
    "clsx": "^2.1.1",
    "ethers": "^6.14.3",
    "framer-motion": "^12.34.3",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.13.0",
    "sass": "^1.89.2",
    "unicornstudio-react": "^2.0.1-1",
    "viem": "^2.46.2",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.2.0"
  }
}
