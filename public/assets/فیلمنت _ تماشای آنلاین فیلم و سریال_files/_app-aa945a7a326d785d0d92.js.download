2a\u0628\u0644\u06cc\u063a\u0627\u062a \u0648 \u0627\u0631\u062a\u0628\u0627\u0637\u0627\u062a\u060c \u0648 \u0628\u0647\u200c \u0639\u0646\u0648\u0627\u0646 \u062c\u0627\u0645\u0639\u200c\u062a\u0631\u06cc\u0646 \u0627\u0643\u0648\u0633\u06cc\u0633\u062a\u0645 \u0631\u0633\u0627\u0646\u0647\u200c\u0627\u06cc \u0627\u06cc\u0631\u0627\u0646\u060c \u0647\u0645\u0631\u0627\u0647 \u0628\u0631\u0646\u062f\u0647\u0627 \u062f\u0631 \u0645\u0633\u06cc\u0631 \u062e\u0644\u0642 \u062a\u062c\u0631\u0628\u0647\u200c\u0647\u0627\u06cc \u0645\u0627\u0646\u062f\u06af\u0627\u0631 \u0647\u0633\u062a\u06cc\u0645. \u0622\u06af\u0647\u200c\u0633\u0627\u0632\u0627\u0646 \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9 \u0622\u0698\u0627\u0646\u0633 \u062a\u0645\u0627\u0645\u200c \u062e\u062f\u0645\u062a \u062a\u0645\u0627\u0645\u06cc\u060c (Full Service Agency) \u062a\u0628\u0644\u06cc\u063a\u0627\u062a\u06cc \u0645\u0631\u0627\u062d\u0644 \u0627\u0632 \u062a\u062d\u0644\u06cc\u0644 \u0648 \u062a\u062f\u0648\u06cc\u0646 \u0627\u0633\u062a\u0631\u0627\u062a\u0698\u06cc \u062a\u0627 \u062e\u0644\u0627\u0642\u06cc\u062a\u060c \u062a\u0648\u0644\u06cc\u062f \u0648 \u0627\u062c\u0631\u0627 \u0631\u0627 \u062f\u0631 \u0645\u0633\u06cc\u0631\u06cc \u06cc\u06a9\u067e\u0627\u0631\u0686\u0647 \u0637\u06cc \u0645\u06cc\u06a9\u0646\u062f \u062a\u0627 \u0628\u0631\u0646\u062f\u0647\u0627 \u0628\u0647\u06cc\u0646\u0647 \u062f\u06cc\u062f\u0647 \u0634\u0648\u0646\u062f\u060c \u0627\u062b\u0631\u0628\u062e\u0634 \u0634\u0646\u06cc\u062f\u0647 \u0634\u0648\u0646\u062f \u0648 \u062f\u0631 \u0630\u0647\u0646 \u0645\u062e\u0627\u0637\u0628 \u0645\u0627\u0646\u062f\u06af\u0627\u0631 \u0628\u0645\u0627\u0646\u0646\u062f. \u0628\u0647\u200c \u0639\u0646\u0648\u0627\u0646 \u0646\u0645\u0627\u06cc\u0646\u062f\u0647 \u0631\u0633\u0645\u06cc \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0648 \u0641\u0631\u0648\u0634 \u0627\u0634\u062a\u0631\u0627\u0643 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0641\u06cc\u0644\u0645\u200c\u0646\u062a\u060c \u0639\u0636\u0648 \u06a9\u0646\u0633\u0631\u0633\u06cc\u0648\u0645 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0645\u062d\u06cc\u0637\u06cc \u06a9\u0634\u0648\u0631\u060c \u0628\u0627 \u062f\u0633\u062a\u0631\u0633\u06cc \u06af\u0633\u062a\u0631\u062f\u0647 \u0628\u0647 \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u062a\u0644\u0648\u06cc\u0632\u06cc\u0648\u0646\u060c \u0631\u0627\u062f\u06cc\u0648\u060c \u0645\u062a\u0631\u0648 \u0648 \u0645\u062c\u0631\u06cc \u0631\u0633\u0645\u06cc \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0633\u06cc\u0646\u0645\u0627\u0647\u0627 \u0648 \u0645\u0631\u0627\u0643\u0632 \u062a\u062c\u0627\u0631\u06cc\u060c \u0631\u0627\u0647\u06a9\u0627\u0631\u0647\u0627\u06cc \u062a\u0628\u0644\u06cc\u063a\u0627\u062a\u06cc \u0645\u062a\u0646\u0627\u0633\u0628 \u0628\u0627 \u0647\u0648\u06cc\u062a \u0648 \u0627\u0647\u062f\u0627\u0641 \u0647\u0631 \u0628\u0631\u0646\u062f \u062f\u0631 \u0647\u0631 \u0631\u0633\u0627\u0646\u0647 \u0631\u0627 \u0637\u0631\u0627\u062d\u06cc \u0648 \u0627\u062c\u0631\u0627 \u0645\u06cc\u06a9\u0646\u06cc\u0645. \u0628\u0631\u0627\u06cc \u062a\u062c\u0631\u0628\u0647\u200c\u06cc \u0647\u0645\u06a9\u0627\u0631\u06cc \u0627\u062b\u0631\u0628\u062e\u0634 \u0628\u0627 \u0622\u06af\u0647\u200c\u0633\u0627\u0632\u0627\u0646\u060c \u0628\u0627 \u0645\u0627 \u062f\u0631 \u062a\u0645\u0627\u0633 \u0628\u0627\u0634\u06cc\u062f.","static.ads.info.second":"\u0634\u0631\u06a9\u062a \u067e\u0631\u06af\u0627\u0631 \u0628\u0646\u06cc\u0627\u0646 \u062f\u0627\u0646\u0627\u06cc\u06cc \u0628\u0627 \u0647\u062f\u0641 \u0627\u0631\u0627\u0626\u0647 \u0631\u0627\u0647\u06a9\u0627\u0631\u0647\u0627\u06cc \u0646\u0648\u06cc\u0646 \u062f\u0631 \u062d\u0648\u0632\u0647\u200c\u06cc \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0645\u062d\u06cc\u0637\u06cc \u0648 \u0628\u0631\u0646\u062f\u06cc\u0646\u06af \u0641\u0639\u0627\u0644\u06cc\u062a \u062e\u0648\u062f \u0631\u0627 \u0622\u063a\u0627\u0632 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a. \u0627\u06cc\u0646 \u0645\u062c\u0645\u0648\u0639\u0647 \u0628\u0627 \u062a\u06a9\u06cc\u0647 \u0628\u0631 \u062e\u0644\u0627\u0642\u06cc\u062a\u060c \u062a\u062c\u0631\u0628\u0647 \u0648 \u062f\u0627\u0646\u0634 \u0631\u0648\u0632\u060c \u062a\u0644\u0627\u0634 \u0645\u06cc\u200c\u06a9\u0646\u062f \u062a\u0627 \u0627\u0631\u062a\u0628\u0627\u0637 \u0645\u0624\u062b\u0631 \u0648 \u0645\u0627\u0646\u062f\u06af\u0627\u0631\u06cc \u0645\u06cc\u0627\u0646 \u0628\u0631\u0646\u062f\u0647\u0627 \u0648 \u0645\u062e\u0627\u0637\u0628\u0627\u0646\u0634\u0627\u0646 \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u062f. \u067e\u0631\u06af\u0627\u0631 \u062f\u0631 \u0632\u0645\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u06af\u0648\u0646\u0627\u06af\u0648\u0646\u06cc \u0647\u0645\u0686\u0648\u0646 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0645\u062d\u06cc\u0637\u06cc (\u0628\u06cc\u0644\u0628\u0648\u0631\u062f\u060c \u067e\u0644\u200c\u0647\u0627\u06cc \u0639\u0627\u0628\u0631 \u0648 \u0627\u0633\u062a\u0646\u062f\u0647\u0627\u06cc \u0634\u0647\u0631\u06cc)\u060c \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 (\u067e\u0631\u06cc\u200c\u0631\u0648\u0644 \u062f\u0631 \u0634\u0628\u06a9\u0647\u200c\u0647\u0627\u06cc \u0646\u0645\u0627\u06cc\u0634 \u062e\u0627\u0646\u06af\u06cc)\u060c \u0648 \u0637\u0631\u0627\u062d\u06cc \u0648 \u062a\u0648\u0644\u06cc\u062f \u0645\u062d\u062a\u0648\u0627 (\u0647\u0648\u06cc\u062a \u0628\u0635\u0631\u06cc\u060c \u062a\u06cc\u0632\u0631 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a\u06cc\u060c \u0637\u0631\u0627\u062d\u06cc \u0644\u0648\u06af\u0648 \u0648 \u067e\u0648\u0633\u062a\u0631) \u0641\u0639\u0627\u0644\u06cc\u062a \u062f\u0627\u0631\u062f. \u062a\u0645\u0631\u06a9\u0632 \u0627\u06cc\u0646 \u0634\u0631\u06a9\u062a \u0628\u0631 \u0627\u062c\u0631\u0627\u06cc \u06a9\u0645\u067e\u06cc\u0646\u200c\u0647\u0627\u06cc \u0647\u062f\u0641\u0645\u0646\u062f \u0648 \u062e\u0644\u0627\u0642\u0627\u0646\u0647 \u0627\u0633\u062a\u061b \u06a9\u0645\u067e\u06cc\u0646\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0628\u0627 \u062a\u062d\u0644\u06cc\u0644 \u062f\u0642\u06cc\u0642 \u0628\u0627\u0632\u0627\u0631 \u0648 \u0646\u06cc\u0627\u0632 \u0645\u0634\u062a\u0631\u06cc\u0627\u0646 \u0637\u0631\u0627\u062d\u06cc \u0645\u06cc\u200c\u0634\u0648\u0646\u062f \u062a\u0627 \u0628\u06cc\u0634\u062a\u0631\u06cc\u0646 \u0628\u0627\u0632\u062f\u0647\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0628\u0631\u0646\u062f\u0647\u0627 \u0628\u0647 \u0627\u0631\u0645\u063a\u0627\u0646 \u0622\u0648\u0631\u0646\u062f. \u0628\u0627 \u0628\u0647\u0631\u0647\u200c\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062a\u06cc\u0645\u06cc \u0645\u062a\u062e\u0635\u0635 \u0648 \u0634\u0628\u06a9\u0647\u200c\u0627\u06cc \u06af\u0633\u062a\u0631\u062f\u0647 \u0627\u0632 \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u0634\u0647\u0631\u06cc\u060c \u067e\u0631\u06af\u0627\u0631 \u0628\u0646\u06cc\u0627\u0646 \u062f\u0627\u0646\u0627\u06cc\u06cc \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9\u06cc \u0627\u0632 \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0647\u0627\u06cc \u0641\u0639\u0627\u0644 \u0648 \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f \u062f\u0631 \u0635\u0646\u0639\u062a \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0627\u06cc\u0631\u0627\u0646 \u0634\u0646\u0627\u062e\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.\u0627\u06cc\u0646 \u0634\u0631\u06a9\u062a \u0645\u0623\u0645\u0648\u0631\u06cc\u062a \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u062a\u0648\u0633\u0639\u0647 \u0641\u0631\u0647\u0646\u06af \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0645\u0624\u062b\u0631 \u0648 \u06a9\u0645\u06a9 \u0628\u0647 \u0631\u0634\u062f \u067e\u0627\u06cc\u062f\u0627\u0631 \u0628\u0631\u0646\u062f\u0647\u0627 \u062a\u0639\u0631\u06cc\u0641 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a.","static.about.intro":"\u062f\u0631 \u0641\u06cc\u0644\u0645\u200c\u0646\u062a\u060c \u0647\u0631 \u0631\u0648\u0632 \u062a\u0644\u0627\u0634 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645 \u062a\u0627 \u0628\u0647 \u0627\u0647\u062f\u0627\u0641 \u0628\u0632\u0631\u06af\u200c\u062a\u0631\u06cc \u062f\u0633\u062a \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u0645. \u0633\u0627\u0644 93\u060c \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0645\u0641\u0647\u0648\u0645 VOD \u0686\u06cc\u0632\u06cc \u0628\u06cc\u0634 \u0627\u0632 \u06cc\u06a9 \u0631\u0648\u06cc\u0627 \u0646\u0628\u0648\u062f\u060c \u0633\u0641\u0631\u0645\u0627\u0646 \u0631\u0627 \u0622\u063a\u0627\u0632 \u06a9\u0631\u062f\u06cc\u0645. \u067e\u0627\u06cc\u0647\u200c\u06af\u0630\u0627\u0631\u0627\u0646 \u0645\u062c\u0645\u0648\u0639\u0647 \u0631\u0648\u06cc\u0627\u06cc \u0633\u0627\u062e\u062a \u0648 \u0627\u0631\u0627\u0626\u06c0 \u0633\u0631\u0648\u06cc\u0633\u06cc \u0631\u0627 \u062f\u0627\u0634\u062a\u0646\u062f \u06a9\u0647 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0622\u0646 \u062a\u0645\u0627\u0645 \u0645\u0631\u062f\u0645 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0632 \u0647\u0631 \u0645\u0646\u0637\u0642\u06c0 \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc \u0648 \u062f\u0631 \u0647\u0631 \u0632\u0645\u0627\u0646 \u0642\u0627\u062f\u0631 \u0628\u0647 \u062a\u0645\u0627\u0634\u0627\u06cc \u0645\u062d\u062a\u0648\u0627\u06cc \u0645\u0648\u0631\u062f\u0646\u0638\u0631 \u062e\u0648\u062f \u0628\u0627\u0634\u0646\u062f.","static.about.effort":"\u0628\u0627 \u0648\u062c\u0648\u062f \u062a\u0645\u0627\u0645 \u0633\u062e\u062a\u06cc\u200c\u0647\u0627 \u062a\u0648\u0627\u0646\u0633\u062a\u06cc\u0645 \u0627\u06cc\u0646 \u0633\u0631\u0648\u06cc\u0633 \u0631\u0627 \u0637\u0631\u0627\u062d\u06cc \u0648 \u0627\u062c\u0631\u0627 \u06a9\u0646\u06cc\u0645 \u0648 \u0646\u0638\u0627\u0631\u0647\u200c\u06af\u0631 \u0631\u0648\u06cc\u0627\u06cc\u06cc \u0628\u0627\u0634\u06cc\u0645 \u06a9\u0647 \u0628\u0647 \u0622\u0631\u0627\u0645\u06cc \u0628\u0647 \u062d\u0642\u06cc\u0642\u062a \u062a\u0628\u062f\u06cc\u0644 \u0645\u06cc\u200c\u0634\u0648\u062f.","static.about.team":"\u062a\u06cc\u0645 \u0645\u0627 \u0647\u0631 \u0631\u0648\u0632 \u0628\u0632\u0631\u06af \u0648 \u0628\u0632\u0631\u06af\u200c\u062a\u0631 \u0634\u062f \u0648 \u0631\u0648\u06cc\u0627\u06cc\u200c\u0645\u0627\u0646 \u0646\u0632\u062f\u06cc\u06a9\u062a\u0631 \u0628\u0647 \u0648\u0627\u0642\u0639\u06cc\u062a. \u062f\u0631 \u0627\u06cc\u0646 \u0645\u0633\u06cc\u0631 \u0686\u0627\u0644\u0634 \u0647\u0627\u06cc \u0628\u0633\u06cc\u0627\u0631\u06cc \u0633\u0631 \u0631\u0627\u0647\u200c\u0645\u0627\u0646 \u0628\u0648\u062f\u061b \u0627\u0632 \u062a\u0627\u0633\u06cc\u0633 \u0627\u0648\u0644\u06cc\u0646 \u062f\u0641\u062a\u0631 \u0645\u0631\u06a9\u0632\u06cc \u06af\u0631\u0641\u062a\u0647 \u062a\u0627 \u0645\u062d\u06a9\u0645 \u06a9\u0631\u062f\u0646 \u062c\u0627\u06cc \u067e\u0627\u06cc\u200c\u0645\u0627\u0646 \u062f\u0631 \u0628\u0627\u0632\u0627\u0631 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0627\u0648\u0644\u06cc\u0646 \u067e\u0644\u062a\u0641\u0631\u0645 \u0631\u0633\u0645\u06cc VOD \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646.","static.about.future":"\u0627\u0645\u0631\u0648\u0632 \u0628\u0627 \u06af\u0630\u0634\u062a \u0686\u0646\u062f\u06cc\u0646 \u0633\u0627\u0644 \u0627\u0632 \u0631\u0648\u0632\u0647\u0627\u06cc \u0622\u063a\u0627\u0632\u06cc\u0646 \u0641\u0639\u0627\u0644\u06cc\u062a\u200c\u0645\u0627\u0646\u060c \u0628\u0627\u0631 \u062f\u06cc\u06af\u0631 \u0628\u0647 \u0645\u0633\u06cc\u0631 \u067e\u06cc\u0634 \u0631\u0648 \u0645\u06cc \u0627\u0646\u062f\u06cc\u0634\u06cc\u0645. \u0628\u0627 \u062a\u062c\u0631\u0628\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u0631\u0627\u0647 \u06a9\u0633\u0628 \u06a9\u0631\u062f\u06cc\u0645\u060c \u0686\u0627\u0628\u06a9 \u062a\u0631 \u0634\u062f\u0647\u200c\u0627\u06cc\u0645 \u0648 \u062f\u0631 \u062d\u0627\u0644 \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0633\u0627\u0632\u0645\u0627\u0646\u060c \u0627\u0646\u062a\u062e\u0627\u0628 \u062f\u0642\u06cc\u0642 \u0634\u0631\u06a9\u0627\u06cc \u062e\u0648\u062f \u0648 \u0633\u0627\u062e\u062a \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u0645\u0633\u062a\u062d\u06a9\u0645 \u0627\u0632 \u0627\u0633\u062a\u0639\u062f\u0627\u062f\u0647\u0627\u060c \u062a\u0648\u0627\u0646\u0627\u06cc\u06cc\u200c\u0647\u0627\u060c \u0647\u0646\u0631\u0645\u0646\u062f\u0627\u0646 \u0648 \u0627\u0631\u0632\u0634\u200c\u0647\u0627 \u0647\u0633\u062a\u06cc\u0645. \u0645\u0627 \u0627\u06cc\u0646\u062c\u0627\u06cc\u06cc\u0645 \u062a\u0627 \u0622\u06cc\u0646\u062f\u0647\u200c\u0627\u06cc \u062c\u062f\u06cc\u062f \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u0635\u0646\u0639\u062a \u0631\u0642\u0645 \u0628\u0632\u0646\u06cc\u0645 \u0648 \u0627\u0631\u0627\u0626\u0647\u200c\u062f\u0647\u0646\u062f\u06c0 \u06a9\u06cc\u0641\u06cc\u062a \u062d\u0642\u06cc\u0642\u06cc\u060c \u0634\u0648\u0631 \u0648 \u0627\u0634\u062a\u06cc\u0627\u0642 \u0648 \u0686\u0634\u0645\u200c\u0627\u0646\u062f\u0627\u0632\u06cc \u062c\u0630\u0627\u0628 \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646\u060c \u0647\u0645\u06a9\u0627\u0631\u0627\u0646 \u0648 \u0634\u0631\u06a9\u0627\u06cc\u200c\u0645\u0627\u0646 \u0628\u0627\u0634\u06cc\u0645.","static.about.follow.us":"\u0645\u0627 \u0631\u0627 \u062f\u0631 \u0634\u0628\u06a9\u0647 \u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u062f\u0646\u0628\u0627\u0644 \u06a9\u0646\u06cc\u062f","static.download.apps.title":"\u062f\u0631\u06cc\u0627\u0641\u062a \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0641\u06cc\u0644\u0645\u200c\u0646\u062a","static.download.apps.description":"\u0628\u0627 \u062f\u0627\u0646\u0644\u0648\u062f \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646\u200c\u0647\u0627\u06cc \u0641\u06cc\u0644\u0645\u200c\u0646\u062a \u062f\u0631 \u0647\u0631 \u0644\u062d\u0638\u0647 \u0648 \u0647\u0631 \u062c\u0627 \u0628\u0647 \u0